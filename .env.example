# Required: Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional but recommended: free key from https://www.pexels.com/api/ for stock footage.
# Without it the bot renders animated text cards instead of real footage.
PEXELS_API_KEY=

# Optional overrides
# VIDEOBOT_MODEL=claude-opus-5-5
# VIDEOBOT_OUTPUT_DIR=videos
